# Live / installer ISO payload image (NOT the installed OS).
#
# Layers the live session + Anaconda onto fluna so the result satisfies
# titanoboa's container-native ISO contract (iso.yaml, dmsquash-live initramfs,
# EFI binaries in /boot/efi). titanoboa consumes THIS image, not the plain
# fluna image — see src/build.sh and .github/workflows/build-iso.yml.
#
# Build (privileged):
#   sudo podman build --cap-add sys_admin --security-opt label=disable --squash \
#     --build-arg BASE_IMAGE=ghcr.io/khoocw97/fluna:latest \
#     --build-arg INSTALL_IMAGE_PAYLOAD=ghcr.io/khoocw97/fluna:latest \
#     -t localhost/fluna-payload:latest installer/
ARG BASE_IMAGE=ghcr.io/khoocw97/fluna:latest
ARG INSTALL_IMAGE_PAYLOAD=ghcr.io/khoocw97/fluna:latest

FROM ${BASE_IMAGE}
ARG BASE_IMAGE
ARG INSTALL_IMAGE_PAYLOAD
RUN --mount=type=bind,source=./src,target=/src \
    env \
    BASE_IMAGE="$BASE_IMAGE" \
    INSTALL_IMAGE_PAYLOAD="$INSTALL_IMAGE_PAYLOAD" \
    /src/build.sh
