#!/bin/bash
# Session wrapper: greetd runs the session on the login VT, so anything printed
# here lands on the console. On Fedora (kernel
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y) the first write to the VT also
# makes fbcon take over and modeset every output, i.e. a blackout between the
# greeter and Umbriel. Two fixes, same as dux-greeter#46 / dux-shell 5b41d69:
#
# 1. clear the VT and hide its cursor, so the console shows a blank screen
#    instead of text while Umbriel starts (ESC [2J erase, [3J scrollback, [?25l
#    cursor off);
# 2. send the session's stdout/stderr to the journal, so no later write can
#    repaint the VT or pull fbcon back in.
printf '\033[2J\033[H\033[3J\033[?25l' >/dev/tty 2>/dev/null || true
exec /usr/bin/systemd-cat -t umbriel-session -- /usr/bin/start-umbriel "$@"
